# ===== Rokate Catering — production sozlamalari =====
# Bu faylni .env nomi bilan nusxalang va to'ldiring. .env ni git'ga QO'SHMANG.

DOMAIN=rokatecatering.com

# Uzun tasodifiy qiymatlar: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
REVALIDATE_SECRET=

# Admin panel manzili (maxfiy yo'l, oxirida / bo'lsin)
ADMIN_URL=manage-rk/

# Google Analytics 4 (G-XXXXXXX) — ixtiyoriy
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (spamga qarshi) — ixtiyoriy
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Arizalar Telegram'ga: @BotFather'dan token. Chat ID admin "Настройки сайта"da ham kiritiladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Arizalar email'ga (SMTP). Bo'sh qolsa — email yuborilmaydi (faqat Telegram/admin).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Rokate Website <no-reply@rokatecatering.com>

# Backup: Cloudflare R2 (S3-mos). Bo'sh qolsa — backup faqat serverda saqlanadi.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rokate-backups
