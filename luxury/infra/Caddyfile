# Caddy: SSL avtomatik (Let's Encrypt). Cloudflare ishlatilsa — SSL rejimi "Full (strict)".
{$DOMAIN} {
	encode zstd gzip

	# Admin panel va API — Django
	handle /{$ADMIN_PATH}* {
		reverse_proxy backend:8000
	}
	handle /api/v1/* {
		reverse_proxy backend:8000
	}
	# Frontend admin (/admin) API
	handle /api/panel/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}

	# Yuklangan rasmlar — to'g'ridan-to'g'ri diskdan, uzoq kesh bilan
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Qolgan hammasi — Next.js sayt
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
